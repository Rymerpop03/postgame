# Copy to .env for local development. .env is gitignored and must never be committed.
#
# The app refuses to boot if a required value is missing, is a known placeholder, or is
# too short. That is deliberate: a placeholder secret that boots is a placeholder secret
# that ships. If you see a startup error here, it is the control working.

# One of: local | staging | production
PG_ENV=local

# Never true in staging or production — config rejects it outright.
PG_DEBUG=true

# 32+ chars. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
PG_SECRET_KEY=

# In production, when the database is not local, this MUST carry sslmode=require, verify-ca or
# verify-full — config refuses to boot otherwise. libpq defaults to sslmode=prefer, which
# encrypts if the server offers it and silently continues in cleartext if it does not, so the
# password and every row can cross the network unprotected with nothing reporting a problem.
# verify-full is best: it also authenticates the server, so interception fails rather than
# succeeding quietly.
#   production example:
#   PG_DATABASE_URL=postgresql+psycopg://user:pass@db.provider.com:5432/postgame?sslmode=verify-full
PG_DATABASE_URL=postgresql+psycopg://postgame_app:dev_app_only@localhost:5432/postgame

# Origins. In production both must be https and must not be localhost.
# App and API share an origin (decision 0.9) so there is no CORS surface at all.
# Locally this must match the port the app serves on (PG_PORT below), or the CSRF
# origin check refuses every sign-in with a 403 about forgery. The app warns at boot.
PG_APP_ORIGIN=http://localhost:8132
# Avatars and covers are served from a separate origin so that an upload which defeats
# every check in Phase 11 still cannot touch app cookies. Same value as APP_ORIGIN in
# local dev is acceptable; it must differ in staging and production.
PG_IMAGE_ORIGIN=http://localhost:8132

# CSP hash for the inline theme-resolver script in postgame/index.html.
# Regenerate with:  python tools/csp_hash.py ../postgame/index.html
PG_CSP_INLINE_SCRIPT_SHA256=sha256-wUSIVEqO+PH+odmhgSQM3zn2YwO5xKTlSifxtLg2E9o=

# Report-only until the console is clean, then flipped in Phase 12 once the cover proxy
# lets us drop the external origins.
PG_CSP_REPORT_ONLY=true

# memory | postgres. The memory backend is Phase 1 scaffolding and config refuses it
# when PG_ENV=production.
PG_RATE_LIMIT_BACKEND=memory

# Path to the static frontend, used by the startup CSP-hash guard.
PG_FRONTEND_DIR=../postgame

PG_LOG_LEVEL=INFO

# Bind address and port.
#   Local, or behind a reverse proxy on the same machine: 127.0.0.1.
#   In a container (Fly, Render, Railway, a Docker host): 0.0.0.0, or nothing outside the
#   container can reach it and the platform health check fails without explaining why.
# A platform-supplied $PORT overrides PG_PORT, which is the convention every PaaS uses.
PG_HOST=127.0.0.1
PG_PORT=8132

# Comma-separated proxy addresses whose X-Forwarded-For we honour. Empty = trust none.
# Set this only to the address of your actual reverse proxy. Trusting forwarded headers
# from arbitrary clients lets anyone claim any IP, which would silently defeat every
# per-IP rate limit added in Phase 5.
#
# The reverse is also a real failure, and less obvious: if something DOES terminate TLS in front
# of this app and this stays empty, then request.client.host is that proxy's address for every
# visitor on the internet. They all share one rate-limit bucket, so one abuser throttles
# everybody. In production, name the proxy — the app warns at boot when this is empty.
PG_TRUSTED_PROXY_IPS=

# ------------------------------------------------------------------------------ Phase 5

# Session lifetimes. Idle expiry or absolute expiry, whichever comes first (decision 0.4):
# a session dies 14 days after it was last used, or 90 days after it was created.
PG_SESSION_IDLE_DAYS=14
PG_SESSION_ABSOLUTE_DAYS=90

# Argon2id cost. The defaults measure ~255 ms per verification on the development machine,
# which is the Phase 5 target. Measure on the machine you actually deploy to:
#
#   python tools/tune_argon2.py
#
# Raising these later needs no migration and no password reset — each stored hash is
# upgraded at its owner's next login (`check_needs_rehash`).
#
# parallelism is 1 rather than the 4 the plan first sketched: p=4 asks for four threads per
# verification, which on a one- or two-core box does not go four times faster, it occupies
# the whole machine for the same elapsed time. time_cost buys the same resistance without
# competing with every other request for a core.
PG_PASSWORD_HASH_MEMORY_KIB=65536
PG_PASSWORD_HASH_TIME_COST=5
PG_PASSWORD_HASH_PARALLELISM=1

# How many passwords may be hashed at the same time. This is a memory bound, not a
# throughput knob: each concurrent verification holds MEMORY_KIB for its whole duration, so
# the peak is MEMORY_KIB x this. At the defaults that is 384 MiB. Without the cap,
# Starlette's 40-slot thread pool would happily ask for 40 x 64 MiB and meet the OOM killer,
# which is a denial of service that needs no credentials and looks like a crash.
# The app logs the computed peak at boot and warns when it exceeds 512 MiB.
PG_PASSWORD_HASH_CONCURRENCY=6

# Path to the common-password list. Empty uses the bundled one, which is generated by
# tools/build_password_list.py and is NOT the real top-100k breach corpus — see the module
# docstring in app/security/breached.py for exactly what it covers. Point this at the real
# corpus when there is one; the app refuses to boot if the file is missing or too small to
# be a control.
PG_PASSWORD_LIST=
